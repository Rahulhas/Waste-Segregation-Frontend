generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  DRIVER
  ADMIN
  
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role           @default(DRIVER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resetTokens   PasswordReset[]
  auditLogs     AuditLog[]
}

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())
}

enum CitizenRequestType {
  overflow
  missed_pickup
  damaged_bin
  bulk_ewaste
}

enum CitizenRequestStatus {
  submitted
  verified
  dispatched
  resolved
}

model CitizenRequest {
  id                   String               @id @default(uuid())
  ticketId             String               @unique
  citizenName          String
  contactNumber        String
  requestType          CitizenRequestType
  latitude             Float
  longitude            Float
  addressString        String
  zone                 String
  photoUrl             String?
  driverProofPhotoUrl  String?
  status               CitizenRequestStatus @default(submitted)
  timestamp            DateTime             @default(now())

  @@index([status, timestamp])
  @@index([zone])
}
